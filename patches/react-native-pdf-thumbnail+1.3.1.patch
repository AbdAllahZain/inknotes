+  /** InkNotes patch: render one page at an arbitrary scale into outPath (JPEG). */
+  @ReactMethod
+  fun renderPage(filePath: String, page: Int, scale: Double, quality: Int, outPath: String, promise: Promise) {
+    var parcelFileDescriptor: ParcelFileDescriptor? = null
+    var pdfRenderer: PdfRenderer? = null
+    try {
+      parcelFileDescriptor = getParcelFileDescriptor(filePath)
+      if (parcelFileDescriptor == null) {
+        promise.reject("FILE_NOT_FOUND", "File $filePath not found")
+        return
+      }
+      pdfRenderer = PdfRenderer(parcelFileDescriptor)
+      if (page < 0 || page >= pdfRenderer.pageCount) {
+        promise.reject("INVALID_PAGE", "Page number $page is invalid, file has ${pdfRenderer.pageCount} pages")
+        return
+      }
+      val currentPage = pdfRenderer.openPage(page)
+      val w = currentPage.width
+      val h = currentPage.height
+      var s = scale
+      val maxDim = 4096.0
+      val biggest = Math.max(w, h).toDouble() * s
+      if (biggest > maxDim) {
+        s = maxDim / Math.max(w, h).toDouble()
+      }
+      val bw = Math.max(1, Math.round(w * s).toInt())
+      val bh = Math.max(1, Math.round(h * s).toInt())
+      val bitmap = Bitmap.createBitmap(bw, bh, Bitmap.Config.ARGB_8888)
+      bitmap.eraseColor(Color.WHITE)
+      val matrix = Matrix()
+      matrix.setScale(bw.toFloat() / w.toFloat(), bh.toFloat() / h.toFloat())
+      currentPage.render(bitmap, null, matrix, PdfRenderer.Page.RENDER_MODE_FOR_DISPLAY)
+      currentPage.close()
+
+      val outFile = File(outPath)
+      outFile.parentFile?.mkdirs()
+      val out = FileOutputStream(outFile)
+      bitmap.compress(Bitmap.CompressFormat.JPEG, quality, out)
+      out.flush()
+      out.close()
+      bitmap.recycle()
+
+      val map = WritableNativeMap()
+      map.putString("uri", Uri.fromFile(outFile).toString())
+      map.putInt("width", w)
+      map.putInt("height", h)
+      map.putInt("pixelWidth", bw)
+      map.putInt("pixelHeight", bh)
+      promise.resolve(map)
+    } catch (ex: OutOfMemoryError) {
+      promise.reject("OUT_OF_MEMORY", "Not enough memory to render this page")
+    } catch (ex: Exception) {
+      promise.reject("INTERNAL_ERROR", ex)
+    } finally {
+      try { pdfRenderer?.close() } catch (e: Exception) {}
+      try { parcelFileDescriptor?.close() } catch (e: Exception) {}
+    }
+  }
